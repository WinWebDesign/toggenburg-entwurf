# ══ Staging WinWebdesign — Gestaltungsentwurf Toggenburg ══
# Muster: movieproduction87.winwebdesign.ch (Portfolio-Inventar 3.3)
# Aufgabe T6: X-Robots-Tag noindex UND Passwortschutz.

# ── 1 · Aus jeder Suchmaschine heraushalten ──
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 2 · Kein Passwort fuer diesen Unterordner ──
# staging.winwebdesign.ch ist als Ganzes per Basic Auth geschuetzt (Realm
# "WinWebDesign Staging"). Auf ausdruecklichen Wunsch soll dieser Entwurf ohne
# Anmeldung erreichbar sein: Rikard Pergega soll den Link oeffnen koennen, ohne
# Zugangsdaten zu brauchen.
#
# Das hebt die geerbte Anmeldung NUR fuer /toggenburg auf. Die Nachbarordner
# swissdrives, jimport und wwd-bot bleiben unveraendert geschuetzt.
# Der Schutz gegen Suchmaschinen bleibt vollstaendig: siehe Abschnitt 1 und die
# meta-robots-Angaben in jeder Datei.
# Wortlaut wie bei swissdrives und wwd-bot, die nachweislich offen sind:
# "Satisfy Any" steht UNBEDINGT davor. Nur im 2.2-Zweig genuegt es nicht —
# auf LiteSpeed ist mod_authz_core geladen, der Zweig laeuft dann nie.
Satisfy Any
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>

# ── 3 · Auslieferung ──
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 7 days"
  ExpiresByType font/woff2        "access plus 30 days"
  ExpiresByType text/css          "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

# ── 4 · Verzeichnisse nicht auflisten ──
Options -Indexes

# Kein ErrorDocument: Im Unterordner zeigte ein absoluter Pfad an der
# Auswahlseite vorbei auf die Wurzel der Subdomain.
